<group name="windows, authentication, brute_force,">
  <!-- Rule to detect multiple failed Windows login attempts (Event ID 4625) -->
  <rule id="100201" level="10" frequency="5" timeframe="120">
    <if_sid>60106</if_sid>
    <match>Windows Security Log: 4625</match>
    <description>Potential Brute-Force Attack Detected: Multiple failed login attempts from source IP.</description>
    <group>authentication_failed,attacks,</group>
    <mitre>
      <id>T1110</id>
      <tactic>Credential Access</tactic>
      <technique>Brute Force</technique>
    </mitre>
  </rule>
</group>
